# NimDares environment configuration.
# Copy this file to .env and fill in your values. Never commit .env.

# Google Gemini API key for VISION adjudication (default model: gemini-3.6-flash).
GEMINI_API_KEY=your_gemini_api_key

# Optional: override the Gemini vision model. gemini-2.5-* is retired (the API
# returns 404 and redirects to 3.6). gemini-3.5-flash-lite is cheaper and ~3x
# faster, but scores tampering less reliably.
# GEMINI_MODEL=gemini-3.6-flash
# Model for the creation-time evidence checklist (defaults to GEMINI_MODEL).
# GEMINI_SPEC_MODEL=

# Verdict thresholds on the judge's completion score (0-100).
# >= VISION_VALID_AT pays out, < VISION_INVALID_BELOW slashes, between the two
# is inconclusive and the stake is returned.
# VISION_VALID_AT=80
# VISION_INVALID_BELOW=40
# Tamper score at or above which a proof is rejected outright.
# VISION_TAMPER_BLOCK_AT=70

# GitHub PAT for GITHUB verifier adjudication.
# GITHUB_TOKEN=

# Strava API token for STRAVA verifier adjudication.
# STRAVA_ACCESS_TOKEN=

# NIM escrow account private key hex (64 chars). Required for real NIM payouts.
# ESCROW_NIM_KEY_HEX=

# EVM/Polygon escrow account private key hex. Required for real USDT payouts.
# ESCROW_EVM_KEY_HEX=

# NIM treasury addresses, resolved per NIMIQ_NETWORK. Suffixed vars take precedence; the
# unsuffixed base var is the fallback.
# Mainnet default (official Nimiq ImpactX Foundation charity wallet, Transparency Report 2018):
#   NQ19 YG54 46TX EHGQ D2R2 V8XA JX84 UFG0 S0MC
# CHARITY_WALLET_MAINNET=
# COMMUNITY_TREASURY_MAINNET=
# CHARITY_WALLET_TESTNET=
# COMMUNITY_TREASURY_TESTNET=
# CHARITY_WALLET=
# COMMUNITY_TREASURY=

# TESTNET only: private key hex of the testnet treasury wallet (quitter's faucet), so a demo
# can redistribute slashed test funds. Never set this on a mainnet deployment.
# TESTNET_TREASURY_KEY_HEX=

# Secret protecting the /api/cron/sweep endpoint.
# CRON_SECRET=

# Supabase Postgres connection string. With it, the app uses Prisma (production).
# Without it, the app falls back to the in-memory store (dev/demo mode).
# DATABASE_URL=

# Polygon network for EVM escrow: "amoy" (default) or "mainnet".
# NEXT_PUBLIC_NETWORK=amoy

# Nimiq network this deployment tracks: "mainnet" (default) or "testnet".
# NIMIQ_NETWORK=mainnet

# Same network, exposed to the browser: the mini app reads wallet balances via the
# Nimiq SDK provider's RPC, so this must match NIMIQ_NETWORK. Note the client also
# self-corrects to the wallet network via nimRpcUrlFor() in lib/config.ts.
# NEXT_PUBLIC_NIMIQ_NETWORK=mainnet
# NEXT_PUBLIC_NIM_RPC_URL=

# RPC overrides (defaults per network: rpc.nimiqwatch.com mainnet / rpc.testnet.nimiqwatch.com testnet).
# NIM_RPC_URL=
# NIM_NETWORK_ID=24
# EVM_RPC_URL=